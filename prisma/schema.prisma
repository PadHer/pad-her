// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model AdminSession {
  id         String   @id
  ipAddress  String
  userAgent  String
  createdAt  DateTime @default(now())
  expiresAt  DateTime
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Volunteer {
  id            Int      @id @default(autoincrement())
  email         String
  firstName     String
  lastName      String
  phone         String?
  skills        String[]
  availability  String[]
  additionalNotes String?
  opportunityId String? @unique
  role          VolunteerRole? @relation(fields: [opportunityId], references: [id])
  status        ApplicationStatus @default(PENDING)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([email, opportunityId])
}


model Donation {
  id            String   @id @default(uuid())
  donationAmount Int
  currency        String   @default("NGN")
  donationType   String
  donorName      String
  donorEmail     String
  isAnon         Boolean  @default(false)
  reference      String   @unique
  status         String   @default("pending") // pending | successful | failed
  createdAt      DateTime @default(now())
  updatedAt     DateTime @default(now()) @updatedAt
}

model NewsletterSubscriber {
  id             String    @id @default(uuid())
  email          String    @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
  unsubscribedAt DateTime?
  unsubscribeRequestedAt DateTime?
}

model ContactMessage {
  id               String   @id @default(uuid())
  fullName         String
  organisation     String?
  emailAddress     String
  phoneNumber      String?
  typeOfEnquiry    String
  website          String?
  message          String
  createdAt        DateTime @default(now())
}

model EventRegistration {
  id            String      @id @default(cuid())
  fullName      String
  emailAddress  String
  phoneNumber   String
  location      String
  whyInterest   String
  isAgreed      Boolean

  eventId       String
  event         CreateEvent  @relation(fields: [eventId], references: [id])

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([eventId, emailAddress])
}

enum EventType {
  CAMPAIGN
  OUTREACH
  WORKSHOP
}

model CreateEvent {
  id            String @id @default(cuid())
  title         String
  type          EventType
  date          DateTime
  location      String
  capacity      Int?
  imageUrl      String?
  imagePublicId String?
  description   String
  registrations  EventRegistration[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

enum VolunteerCategory {
  DIGITAL_ADVOCACY
  COMMUNITY_OUTREACH
  EDUCATION_AND_TRAINING
}

model VolunteerRole {
  id            String @id @default(cuid())
  roleTitle     String
  description   String
  requirements  String
  category      VolunteerCategory
  slots         Int
  applicationDeadline DateTime?
  createdAt           DateTime    @default(now())
  applicants   Volunteer[]
}

model ImpactStat {
  id          String   @id @default(uuid())
  key         String   @unique
  label       String
  value       Int
  description String?
  icon        String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}